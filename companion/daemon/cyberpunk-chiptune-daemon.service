[Unit]
Description=Cyberpunk Chiptune Player Daemon
After=pipewire.service

[Service]
Type=simple
# The daemon's autogen runs the bitcomposer command, which pipx installs in
# ~/.local/bin; a user service does not have that directory on PATH by
# itself. A developer's checkout instead reaches the daemon through the
# drop-in companion/install.sh --dev writes next to this unit
# (PYTHONPATH to the checkout), and the daemon falls back to
# "python3 -m bitcomposer.cli" when there is no command. See docs/INSTALL.md.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Unbuffered so the daemon's log lines reach journalctl as they happen rather
# than in one burst when the process exits.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.local/bin/cyberpunk-chiptune-daemon.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
